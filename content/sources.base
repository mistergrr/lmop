views:
  - type: table
    name: Magic Items
    filters:
      or:
        - file.tags.contains("lore")
        - Category == "magic item"
    groupBy:
      property: Type
      direction: ASC
    order:
      - file.name
      - Type
      - Rarity
    columnSize:
      file.name: 533
      note.Type: 180
  - type: table
    name: Locations
    filters:
      and:
        - category == "Location"
    order:
      - file.name
      - geography
      - location
    sort:
      - property: location
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 228
      note.geography: 121
  - type: cards
    name: Deities
    filters:
      and:
        - category.contains("Deity")
    order:
      - file.name
      - tags
    columnSize:
      file.name: 497
      note.tags: 648
  - type: list
    name: Factions
    filters:
      or:
        - Category == "Faction"
    order:
      - file.name
    markers: number
